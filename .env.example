# ============================================================================
# ReadSpace — server configuration
# Copy this file to `.env` (it lives in the repo root, next to package.json):
#
#     cp .env.example .env
#
# The server auto-loads `.env` on start (simple KEY=VALUE lines, # comments).
# Real system environment variables always win over .env values.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. App
# ----------------------------------------------------------------------------
# Port the one-process server listens on (serves /, /m/ and /api/*).
PORT=5173

# Public base URL of your deployment. Used to build the Google OAuth redirect.
# Local dev over http is fine; production should be an https:// URL.
# Leave empty to derive from the incoming request (dev convenience only).
APP_BASE_URL=

# Optional explicit override of the OAuth redirect URI. Defaults to:
#   ${APP_BASE_URL}/api/auth/google/callback
# This EXACT value must also be registered in Google Cloud Console (see README
# → "Connect your real Google Drive (OAuth setup)").
GOOGLE_REDIRECT_URI=

# ----------------------------------------------------------------------------
# 2. Google OAuth 2.0 + Drive API  (the "client id and secret key")
# ----------------------------------------------------------------------------
# Create these in Google Cloud Console → APIs & Services → Credentials:
#   1. Enable the Google Drive API for the project.
#   2. Configure the OAuth consent screen (scopes: openid, email, profile,
#      https://www.googleapis.com/auth/drive).
#   3. Create an OAuth client ID → type "Web application" → add
#      `https://YOUR-HOST/api/auth/google/callback` as an Authorized
#      redirect URI.
#   4. Copy the Client ID and Client secret here.
#
# IMPORTANT: when BOTH values below are set, the server talks to REAL Google.
# Leave both empty to run the built-in sandbox (mock Google sign-in + mock
# Drive with sample files — no network, no real account).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----------------------------------------------------------------------------
# 3. Security
# ----------------------------------------------------------------------------
# AES-256-GCM key material used to encrypt Google refresh tokens at rest
# (server-side only — tokens are NEVER sent to any frontend).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED before any real deployment; a dev fallback key is used (with a
# loud warning) when unset.
TOKEN_ENCRYPTION_KEY=

# ----------------------------------------------------------------------------
# 4. Database (optional — v1.1 §14 metadata adapter seam)
# ----------------------------------------------------------------------------
# Unset → JSON file store at data/readspace-db.json (zero infrastructure).
# Set    → MongoDB/Atlas connection string (same document shapes).
MONGODB_URI=
