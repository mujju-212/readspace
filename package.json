{
  "name": "readspace",
  "private": true,
  "version": "0.2.0",
  "description": "ReadSpace — a VS Code–style reader workspace for notes and documents (MD, PDF, DOCX, HTML, TXT)",
  "type": "module",
  "scripts": {
    "dev": "vite",
