    "@uiw/react-codemirror": "^4.23.0",
    "dompurify": "^3.1.6",
    "highlight.js": "^11.10.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.8.0",
    "marked": "^12.0.2",
    "mongodb": "^7.7.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
